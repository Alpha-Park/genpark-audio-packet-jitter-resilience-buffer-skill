{
  "manifest_version": "0.3",
  "name": "genpark-jitter-buffer",
  "version": "1.0.1",
  "description": "Packet ordering simulation and inter-arrival jitter telemetry.",
  "author": {
    "name": "GenPark AI Engineering"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alpha-Park/genpark-audio-packet-jitter-resilience-buffer-skill"
  },
  "server": {
    "type": "python",
    "entry_point": "mcp_server.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "${__dirname}/mcp_server.py"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.9"
    }
  }
}
